APP_ENV=local
PUBLIC_BASE_URL=http://localhost:6752
LOCAL_HTTP_PORT=6752
POSTGRES_DB=cyber_digest
POSTGRES_USER=cyber_digest
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=editor@localhost
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=
GIGACHAT_CA_BUNDLE=/app/config/certs/russian-root.crt
GIGACHAT_TIMEOUT_SECONDS=60
GIGACHAT_MAX_RETRIES=3
GIGACHAT_TEMPERATURE=0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RECIPIENT_ALLOWLIST=
AUTO_SEND_ENABLED=false
MAX_UPLOAD_MB=20
MAX_FETCH_RESPONSE_MB=5
FETCH_TIMEOUT_SECONDS=20

ENABLE_DEMO=false
INITIAL_SOURCE_NAMES=SecurityLab,CNews,Хабр
DAILY_SCHEDULE_ENABLED=true
SMTP_SECURITY=starttls
